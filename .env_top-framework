# DB_USER und DB_PASS entsprechend der Angaben von DB_DATAPROCESSOR_USER bzw. 
# DB_DATAPROCESSOR_PASSWORD aus der cds_hub_db_config.toml anpassen. 
DB_USER=db2dataprocessor_user
DB_PASS=db2dataprocessor
# Müssen für die Verwendung mit 'docker compose' nicht angepasst werden.
DB_HOST="cds_hub"
DB_PORT=5432
# In der Variable DB_NAME muss der Name einer pseudonymisierten Datenbank 
# oder einer Datenbank, die Patienten mit Broad Consent enthält. Nur in 
# diesen aus Snaptshots erzeugten Datenbanken sind die für das TOP-Framework
# benötigten Tabellen- Spalten enthalten.
DB_NAME="<configure pseud./consent database name here>"
