    "titles": [
      {
        "lang": "de",
        "text": "< LLN - 3 mmol/L"
      },
      {
        "lang": "en",
        "text": "< LLN - 3 mmol/L"
      }
    ],
    "synonyms": [

    ],
    "descriptions": [
      {
        "lang": "de",
        "text": "CTCAE Grad 1/2, da keine Unterscheidung zwischen symptomatisch oder nicht möglich. Der LLN-Wert variiert von Klinikum zu Klinikum. Hier wurde beispielsweise 3,5 mmol/L als unterer Grenzwert gewählt."
      },
      {
        "lang": "en",
        "text": "CTCAE Grade 1/2, as no distinction between symptomatic or not possible. The LLN value varies from hospital to hospital. Here, for example, 3.5 mmol/L was chosen as the lower limit."
      }
    ],
