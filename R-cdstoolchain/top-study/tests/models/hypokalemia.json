        "text": "Algorithmus 1 A"
      },
      {
        "lang": "en",
        "text": "Algorithm 1 A"
      }
    ],
    "synonyms": [

    ],
    "descriptions": [
      {
        "lang": "de",
        "text": "Algorithmus zur Identifikation von Hypokaliämie. Der Algorithmus basiert ausschließlich auf der Kaliumkonzentration im Serum/Plasma. Kodierung: LOINC 2823-3 (Kalium Serum/Plasma)"
      },
      {
        "lang": "en",
        "text": "Algorithm for the identification of hypokalaemia. The algorithm is based exclusively on the potassium level in serum/plasma. Coding: LOINC 2823-3 (Potassium Serum/Plasma)"
      }
    ],
    "codes": [

    ],
