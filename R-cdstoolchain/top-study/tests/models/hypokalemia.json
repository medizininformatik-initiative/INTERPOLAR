  {
    "entityType": "single_restriction",
    "id": "b97b4953-3c12-4019-964b-30a40fa13a0d",
    "titles": [
      {
        "lang": "de",
        "text": "< 3,5 mmol/L"
      },
      {
        "lang": "en",
        "text": "< 3.5 mmol/L"
      }
    ],
    "synonyms": [

    ],
    "descriptions": [
      {
        "lang": "de",
        "text": "LOINC 2823-3 unterscheidet nicht zwischen Probenart (Serum oder Plasma) trotz unterschiedlicher Grenzwerte. Grenzwert < 3,5 mmol/L bezieht sich auf Bestimmung im Plasma. Bei Grentwert < 3,5 mmol/L sind falsch-negative Ergebnisse für Serumproben enthalten (da Grenzwert Serum < 3,7 mmol/L)."
      },
      {
        "lang": "en",
        "text": "LOINC 2823-3 does not distinguish between sample type (serum or plasma) despite different limits. Limit value < 3.5 mmol/L refers to determination in plasma. Limit value < 3.5 mmol/L includes false-negative results for serum samples (because limit value serum < 3.7 mmol/L)."
      }
    ],
    "codes": [

    ],
